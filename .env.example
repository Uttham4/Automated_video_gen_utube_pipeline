# NVIDIA NIM API Settings
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=120
STORY_MODEL=nvidia/nemotron-3-super-120b-a12b
SAFETY_MODEL=nvidia/nemotron-3.5-content-safety
IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# local animates still images; comfyui generates LTX video on this PC; pixazo is hosted
VIDEO_GENERATION_PROVIDER=local  # options: local, comfyui, pixazo
PIXAZO_API_KEY=
PIXAZO_VIDEO_API_URL=https://api.pixazo.ai/v1/text-to-video
PIXAZO_VIDEO_RESOLUTION=720p
COMFYUI_API_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_SECONDS=1800
COMFYUI_WIDTH=512
COMFYUI_HEIGHT=288
COMFYUI_FPS=12
COMFYUI_MAX_FRAMES=49

# Fallback Open AI / Local settings
OPENAI_API_KEY=

# Audio / Voice Settings
TTS_ENGINE=edge-tts  # options: edge-tts, gtts
DEFAULT_VOICE=en-US-AnaNeural # Kid-friendly neural voice
TTS_SPEED=+0%

# Web & Approval Settings
PORT=8000
HOST=127.0.0.1
APP_URL=http://localhost:8000

# Gmail API Settings
GMAIL_SENDER_EMAIL=
GMAIL_RECIPIENT_EMAIL=
GMAIL_APP_PASSWORD=

# YouTube Settings
YOUTUBE_PRIVACY_STATUS=private  # private, unlisted, public
YOUTUBE_CATEGORY_ID=27          # 27 = Education, 1    = Film & Animation
